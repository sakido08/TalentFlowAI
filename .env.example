# PostgreSQL is recommended. Replace "your-password" with your local database password.
DATABASE_URL=postgresql+psycopg://talentflow:your-password@localhost:5432/talentflow
# For a quick demo without PostgreSQL, use:
# DATABASE_URL=sqlite:///./talentflow.db

# Replace this with a long random value before sharing a deployed instance.
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=uploads
# Optional semantic matching. Install sentence-transformers before setting this:
# SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
